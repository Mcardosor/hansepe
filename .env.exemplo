# Conexão com o banco cenarios_ai (via VPN).
#
# Copie para `.env` e preencha. O `.env` é ignorado pelo git — nem a senha
# nem o endereço do servidor entram no repositório, que é público.
#
#     cp .env.exemplo .env
#
# O host está com a equipe; a aplicação **não** precisa dele para rodar (lê
# dos parquets). Só leitura: nunca se escreve nesta base.

CENARIOS_HOST=
CENARIOS_PORT=5432
CENARIOS_DB=cenarios_ai
CENARIOS_USER=
CENARIOS_PASSWORD=
